<?xml version="1.0" encoding="UTF-8"?>
<!-- Preferences: instant-apply, plain words, searchable. Uninstall lives at the
     bottom of Advanced, alone, and is confirmed. -->
<interface>
  <object class="AdwPreferencesDialog" id="dialog">
    <property name="search-enabled">True</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="name">general</property>
        <property name="title">General</property>
        <property name="icon-name">emblem-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Startup</property>
            <child>
              <object class="AdwSwitchRow">
                <property name="title">Start with the computer</property>
                <property name="subtitle">Sites open as soon as you log in, even if this window is closed</property>
                <property name="active">True</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Networks</property>
            <child>
              <object class="AdwSwitchRow">
                <property name="title">Remember each Wi‑Fi network</property>
                <property name="subtitle">Uses the right method by itself at home, at work or on mobile data</property>
                <property name="active">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow">
                <property name="title">Tell me when a site stops opening</property>
                <property name="subtitle">Checks your sites quietly every hour</property>
                <property name="active">True</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Updates</property>
            <child>
              <object class="AdwSwitchRow">
                <property name="title">Get new methods automatically</property>
                <property name="subtitle">Downloads methods that work well in your country. Nothing about you is sent.</property>
                <property name="active">True</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title">Zapret</property>
                <property name="subtitle">Up to date</property>
                <child type="suffix">
                  <object class="GtkButton">
                    <property name="label">Check</property>
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage">
        <property name="name">advanced</property>
        <property name="title">Advanced</property>
        <property name="icon-name">preferences-system-network-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Connections</property>
            <child>
              <object class="AdwSwitchRow">
                <property name="title">Unblock voice and video calls</property>
                <property name="subtitle">Needed for Discord voice chat with some internet providers</property>
                <property name="active">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow">
                <property name="title">IPv6</property>
                <property name="subtitle">Leave on unless someone tells you otherwise</property>
                <property name="active">True</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title">Private site lookups</property>
                <property name="subtitle">Not needed on this network</property>
                <property name="activatable">True</property>
                <child type="suffix"><object class="GtkImage"><property name="icon-name">go-next-symbolic</property></object></child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">For Experts</property>
            <child>
              <object class="AdwSwitchRow">
                <property name="title">Show technical details in lists</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow">
                <property name="title">Ports</property>
                <property name="text">TCP 80, 443 · UDP 443</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title">Open configuration folder</property>
                <property name="activatable">True</property>
                <child type="suffix"><object class="GtkImage"><property name="icon-name">adw-external-link-symbolic</property></object></child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwButtonRow">
                <property name="title">Reset to Defaults…</property>
              </object>
            </child>
            <child>
              <object class="AdwButtonRow">
                <property name="title">Uninstall Zapret…</property>
                <style><class name="destructive-action"/></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
