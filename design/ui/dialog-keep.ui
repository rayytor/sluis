<?xml version="1.0" encoding="UTF-8"?>
<!-- Shown only when a just-chosen strategy fails the automatic site check.
     Like GNOME Display settings: it reverts by itself if ignored. -->
<interface>
  <object class="AdwAlertDialog" id="dialog">
    <property name="heading">Keep Method 3?</property>
    <property name="body">Discord didn’t open with it, so Zapret will switch back to Method 1 in 12 seconds.</property>
    <property name="default-response">revert</property>
    <property name="close-response">revert</property>
    <responses>
      <response id="keep">Keep Anyway</response>
      <response id="revert" appearance="suggested">Switch Back</response>
    </responses>
  </object>
</interface>
