<?xml version="1.0" encoding="UTF-8"?>
<!-- Home: everything works. The one question users have ("do my sites open?")
     is answered before anything else. -->
<interface>
  <menu id="primary_menu">
    <section>
      <item><attribute name="label">Import Methods…</attribute></item>
      <item><attribute name="label">Export Methods…</attribute></item>
    </section>
    <section>
      <item><attribute name="label">Preferences</attribute></item>
      <item><attribute name="label">Keyboard Shortcuts</attribute></item>
      <item><attribute name="label">About Zapret</attribute></item>
    </section>
  </menu>
  <object class="AdwApplicationWindow" id="window">
    <property name="title">Zapret</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toasts">
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="title-widget">
                  <object class="AdwWindowTitle">
                    <property name="title">Zapret</property>
                    <property name="subtitle">Home Wi‑Fi</property>
                  </object>
                </property>
                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="menu-model">primary_menu</property>
                    <property name="primary">True</property>
                    <property name="tooltip-text">Main Menu</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">520</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">24</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>

                        <!-- hero -->
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">sluis-freed-symbolic</property>
                                <property name="pixel-size">64</property>
                                <property name="halign">center</property>
                                <property name="margin-bottom">12</property>
                                <style><class name="hero-icon"/><class name="ok"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Your Sites Are Unblocked</property>
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                                <style><class name="title-1"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Discord, YouTube, Roblox and Wattpad all open</property>
                                <property name="wrap">True</property>
                                <property name="justify">center</property>
                                <style><class name="dim-label"/></style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="AdwSwitchRow">
                                <property name="title">Unblocking</property>
                                <property name="subtitle">On · Starts by itself with your computer</property>
                                <property name="active">True</property>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Your Sites</property>
                            <property name="header-suffix">
                              <object class="GtkButton">
                                <property name="valign">center</property>
                                <property name="tooltip-text">Check All Sites (Ctrl+R)</property>
                                <property name="child">
                                  <object class="AdwButtonContent">
                                    <property name="icon-name">view-refresh-symbolic</property>
                                    <property name="label">Check Now</property>
                                  </object>
                                </property>
                                <style><class name="flat"/></style>
                              </object>
                            </property>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Discord</property>
                                <property name="subtitle">discord.com</property>
                                <child type="suffix"><object class="GtkLabel"><property name="label">Opens</property><style><class name="dim-label"/></style></object></child>
                                <child type="suffix"><object class="GtkImage"><property name="icon-name">object-select-symbolic</property><property name="tooltip-text">Opens</property><style><class name="success"/></style></object></child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">YouTube</property>
                                <property name="subtitle">youtube.com</property>
                                <child type="suffix"><object class="GtkLabel"><property name="label">Opens</property><style><class name="dim-label"/></style></object></child>
                                <child type="suffix"><object class="GtkImage"><property name="icon-name">object-select-symbolic</property><style><class name="success"/></style></object></child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Roblox</property>
                                <property name="subtitle">roblox.com</property>
                                <child type="suffix"><object class="GtkLabel"><property name="label">Opens</property><style><class name="dim-label"/></style></object></child>
                                <child type="suffix"><object class="GtkImage"><property name="icon-name">object-select-symbolic</property><style><class name="success"/></style></object></child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Wattpad</property>
                                <property name="subtitle">wattpad.com</property>
                                <child type="suffix"><object class="GtkLabel"><property name="label">Opens</property><style><class name="dim-label"/></style></object></child>
                                <child type="suffix"><object class="GtkImage"><property name="icon-name">object-select-symbolic</property><style><class name="success"/></style></object></child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwPreferencesGroup">
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">How Zapret unblocks</property>
                                <property name="subtitle">Method 1, picked for you</property>
                                <property name="activatable">True</property>
                                <child type="suffix"><object class="GtkImage"><property name="icon-name">go-next-symbolic</property></object></child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Which sites</property>
                                <property name="subtitle">All sites, except 1</property>
                                <property name="activatable">True</property>
                                <child type="suffix"><object class="GtkImage"><property name="icon-name">go-next-symbolic</property></object></child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkButton">
                            <property name="label">Something Not Working?</property>
                            <property name="halign">center</property>
                            <style><class name="pill"/></style>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
