<?xml version="1.0" encoding="UTF-8"?>
<!-- Quick Scan, step 3: the answer, the proof, one primary action. -->
<interface>
  <object class="AdwApplicationWindow" id="window">
    <property name="title">Unblock Sites</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle"><property name="title">Unblock Sites</property></object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">520</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">24</property>
                    <property name="margin-top">24</property>
                    <property name="valign">center</property>
                    <property name="margin-bottom">24</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">sluis-freed-symbolic</property>
                            <property name="pixel-size">64</property>
                            <property name="halign">center</property>
                            <property name="margin-bottom">12</property>
                            <style><class name="hero-icon"/><class name="ok"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Found a Way Around the Block</property>
                            <property name="wrap">True</property>
                            <property name="justify">center</property>
                            <style><class name="title-1"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Method 1 opened every site, twice, and your other sites still work. It took 38 seconds.</property>
                            <property name="wrap">True</property>
                            <property name="justify">center</property>
                            <property name="max-width-chars">44</property>
                            <style><class name="dim-label"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwActionRow">
                            <property name="title">Discord</property>
                            <child type="suffix"><object class="GtkLabel"><property name="label">Opens</property><style><class name="dim-label"/></style></object></child>
                            <child type="suffix"><object class="GtkImage"><property name="icon-name">object-select-symbolic</property><style><class name="success"/></style></object></child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title">Roblox</property>
                            <child type="suffix"><object class="GtkLabel"><property name="label">Opens</property><style><class name="dim-label"/></style></object></child>
                            <child type="suffix"><object class="GtkImage"><property name="icon-name">object-select-symbolic</property><style><class name="success"/></style></object></child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title">YouTube and Wattpad</property>
                            <child type="suffix"><object class="GtkLabel"><property name="label">Open</property><style><class name="dim-label"/></style></object></child>
                            <child type="suffix"><object class="GtkImage"><property name="icon-name">object-select-symbolic</property><style><class name="success"/></style></object></child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title">Your 12 other sites</property>
                            <child type="suffix"><object class="GtkLabel"><property name="label">Still work</property><style><class name="dim-label"/></style></object></child>
                            <child type="suffix"><object class="GtkImage"><property name="icon-name">object-select-symbolic</property><style><class name="success"/></style></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="halign">center</property>
                        <child>
                          <object class="GtkButton">
                            <property name="label">Turn It On</property>
                            <style><class name="pill"/><class name="suggested-action"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="label">Keep Looking</property>
                            <property name="tooltip-text">Keep trying other methods in the background to find a faster one</property>
                            <style><class name="pill"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
