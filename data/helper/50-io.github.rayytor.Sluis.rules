// For desktops without a polkit authentication agent (torOS): members of
// wheel in the active local session may change Zapret without a password,
// as they may mount disks. Installed with -Dwheel_rule=true.
polkit.addRule(function (action, subject) {
    if (action.id.indexOf("io.github.rayytor.Sluis.") === 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
